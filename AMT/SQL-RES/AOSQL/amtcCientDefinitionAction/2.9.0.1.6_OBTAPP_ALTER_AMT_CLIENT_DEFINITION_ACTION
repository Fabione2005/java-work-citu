SET SERVEROUTPUT ON
SET DEFINE OFF
SET ECHO ON
ALTER SESSION SET current_schema=OBTAPP;

DECLARE
    COLUMN_COUNT NUMBER;
BEGIN
    SELECT COUNT(*) INTO COLUMN_COUNT
    FROM SYS.ALL_TAB_COLUMNS
    WHERE OWNER = 'OBTAPP'
      AND TABLE_NAME = 'AMT_CLIENT_DEFINITION_ACTION'
      AND COLUMN_NAME = 'REQUEST_ID';

    IF COLUMN_COUNT < 1 THEN
        EXECUTE IMMEDIATE 'ALTER TABLE OBTAPP.AMT_CLIENT_DEFINITION_ACTION ADD REQUEST_ID VARCHAR2(50 CHAR)';
        DBMS_OUTPUT.PUT_LINE('SUCCESS : REQUEST_ID');
    ELSE
        DBMS_OUTPUT.PUT_LINE('SKIPPED : REQUEST_ID already exists');
    END IF;


    SELECT COUNT(*) INTO COLUMN_COUNT
    FROM SYS.ALL_TAB_COLUMNS
    WHERE OWNER = 'OBTAPP'
      AND TABLE_NAME = 'AMT_CLIENT_DEFINITION_ACTION'
      AND COLUMN_NAME = 'IS_SEPA_ELIGIBLE';

    IF COLUMN_COUNT < 1 THEN
        EXECUTE IMMEDIATE 'ALTER TABLE OBTAPP.AMT_CLIENT_DEFINITION_ACTION ADD IS_SEPA_ELIGIBLE VARCHAR2(1 CHAR)';
        DBMS_OUTPUT.PUT_LINE('SUCCESS : IS_SEPA_ELIGIBLE');
    ELSE
        DBMS_OUTPUT.PUT_LINE('SKIPPED : IS_SEPA_ELIGIBLE already exists');
    END IF;

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        DBMS_OUTPUT.PUT_LINE('ERROR : ' || SQLERRM);
        RAISE;
END;
/
