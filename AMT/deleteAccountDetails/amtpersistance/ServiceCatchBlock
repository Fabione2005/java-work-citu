} catch (FeignException e) {
    log.error("Downstream error from service B. status: {}, body: {}", e.status(), e.contentUTF8(), e);

    HttpStatus status;
    try {
        status = HttpStatus.valueOf(e.status());
    } catch (Exception ex) {
        status = HttpStatus.INTERNAL_SERVER_ERROR;
    }

    DeleteAccountDetailsResponse response = new DeleteAccountDetailsResponse();
    response.setStatus("failure");

    if (HttpStatus.NOT_FOUND.equals(status)) {
        response.setMessage(CommonConstant.DeleteAccountActionsResponseMessage.NOT_RECORD_FOUND);
        response.setError(null);
        return ResponseEntity.status(HttpStatus.NOT_FOUND).body(response);
    }

    if (HttpStatus.BAD_REQUEST.equals(status)) {
        response.setMessage(CommonConstant.DeleteAccountActionsResponseMessage.INVALID_REQUEST);
        response.setError(null);
        return ResponseEntity.badRequest().body(response);
    }

    response.setMessage(CommonConstant.DeleteAccountActionsResponseMessage.INTERNAL_ERROR);
    response.setError(null);
    return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(response);
}
