SELECT
    R.REQUEST_ID,
    A.ACCOUNT_NUMBER,
    NVL(A.NEW_NAME, A.EXISTING_NAME) AS ACCOUNT_NAME,
    A.BRANCH_CODE,
    RE.STR1 AS ACCOUNT_BRANCH_NAME,
    NVL(A.ACCOUNT_DOMICILE_COUNTRY_CODE, R.ACCT_DOMICILE_COUNTRY_CODE) AS ACCOUNT_DOMICILE,
    A.GFC_ID,
    R.LEGAL_ENTITY_NAME
FROM AMT_ACCOUNT_REQUEST A
INNER JOIN AMT_REQUEST R
        ON R.REQUEST_ID = A.REQUEST_ID
LEFT JOIN VW_AMT_REFS_BRANCHCODESLOOKUP RE
       ON RE.STR2 = A.BRANCH_CODE
      AND RE.STATUS = 1
WHERE R.REQUEST_ID IN (
    '2011042100020100482',
    '2011042100020100480',
    '2011042100020100478'
)
ORDER BY R.REQUEST_ID;
