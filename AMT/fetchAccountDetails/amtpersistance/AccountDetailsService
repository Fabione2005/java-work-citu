@Service
@RequiredArgsConstructor
public class AccountDetailsService {

    private final AmtAccountRequestRepository amtAccountRequestRepository;

    public AccountDetailsResponseDto retrieveAccountDetails(
            String parentRequestId,
            List<String> requestIds) {

        String requestIdsCsv = buildRequestIdsCsv(requestIds);

        List<Object[]> rows = amtAccountRequestRepository
                .retrieveAccountDetails(parentRequestId, requestIdsCsv);

        List<AccountDetailsDto> accountsDetails = rows.stream()
                .map(this::mapRowToDto)
                .collect(Collectors.toList());

        return AccountDetailsResponseDto.builder()
                .accountsDetails(accountsDetails)
                .build();
    }

    private AccountDetailsDto mapRowToDto(Object[] row) {
        return AccountDetailsDto.builder()
                .accountNo(getString(row, 5))
                .accountName(getString(row, 6))
                .accountBranchCode(getString(row, 9))
                .accountBranchName(getString(row, 10))
                .accountDomicile(getString(row, 11))
                .accountGfcId(getString(row, 12))
                .accountLegalEntity(getString(row, 13))
                .build();
    }

    private String buildRequestIdsCsv(List<String> requestIds) {
        if (requestIds == null || requestIds.isEmpty()) {
            return null;
        }

        String csv = requestIds.stream()
                .filter(Objects::nonNull)
                .map(String::trim)
                .filter(value -> !value.isEmpty())
                .collect(Collectors.joining(","));

        return csv.isEmpty() ? null : csv;
    }

    private String getString(Object[] row, int index) {
        if (row == null || index >= row.length || row[index] == null) {
            return null;
        }
        return String.valueOf(row[index]);
    }
}
