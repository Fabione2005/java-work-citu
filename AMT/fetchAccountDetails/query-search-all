SELECT
    R.PARENT_REQUEST_ID,
    R.REQUEST_ID,
    A.ACCOUNT_REQUEST_ID,
    A.ACCOUNT_NUMBER AS ACCOUNT_NO,
    NVL(A.NEW_NAME, A.EXISTING_NAME) AS ACCOUNT_NAME,
    A.BRANCH_CODE AS ACCOUNT_BRANCH_CODE,
    NVL(A.ACCOUNT_DOMICILE_COUNTRY_CODE, R.ACCT_DOMICILE_COUNTRY_CODE) AS ACCOUNT_DOMICILE,
    NVL(A.GFC_ID, P.GFP_ID) AS ACCOUNT_GFC_ID,
    NVL(L.LEGAL_ENTITY_NAME, R.LEGAL_ENTITY_NAME, P.PARENT_LEGAL_ENTITY_NAME) AS ACCOUNT_LEGAL_ENTITY,
    R.STATUS_CODE AS REQUEST_STATUS_CODE,
    P.STATUS_CODE AS PARENT_REQUEST_STATUS_CODE,
    R.CREATED_ON
FROM AMT_ACCOUNT_REQUEST A
INNER JOIN AMT_REQUEST R
        ON R.REQUEST_ID = A.REQUEST_ID
LEFT JOIN AMT_PARENT_REQUEST P
       ON P.PARENT_REQUEST_ID = R.PARENT_REQUEST_ID
LEFT JOIN LEGAL_ENTITY L
       ON L.GFC_ID = A.GFC_ID
WHERE R.PARENT_REQUEST_ID IS NOT NULL
ORDER BY R.CREATED_ON DESC
FETCH FIRST 50 ROWS ONLY;
