SELECT DISTINCT
    A.ACCOUNT_REQUEST_ID,
    A.ACCOUNT_ID,
    R.REQUEST_ID,
    R.PARENT_REQUEST_ID,
    P.SUPER_REQUEST_ID,
    A.ACCOUNT_NUMBER,
    COALESCE(A.NEW_NAME, A.EXISTING_NAME) AS ACCOUNT_NAME,
    A.EXISTING_NAME,
    A.NEW_NAME,
    A.BRANCH_CODE,
    RE.STR1 AS ACCOUNT_BRANCH_NAME,
    COALESCE(A.ACCOUNT_DOMICILE_COUNTRY_CODE, R.ACCT_DOMICILE_COUNTRY_CODE) AS ACCOUNT_DOMICILE,
    COALESCE(A.GFC_ID, P.GFP_ID) AS ACCOUNT_GFC_ID,
    NVL(L.LEGAL_ENTITY_NAME, NVL(R.LEGAL_ENTITY_NAME, P.PARENT_LEGAL_ENTITY_NAME)) AS ACCOUNT_LEGAL_ENTITY,
    L.LEGAL_ENTITY_NAME AS LEGAL_ENTITY_NAME_FROM_TABLE,
    R.LEGAL_ENTITY_NAME AS LEGAL_ENTITY_NAME_FROM_REQUEST,
    P.PARENT_LEGAL_ENTITY_NAME AS LEGAL_ENTITY_NAME_FROM_PARENT,
    A.REGION_CODE AS ACCOUNT_REGION_CODE,
    R.REGION_CODE AS REQUEST_REGION_CODE,
    A.ACCOUNT_STATUS,
    A.ACCOUNT_SOURCE,
    A.ACCOUNT_CATEGORY,
    A.LOCATION,
    A.ACCOUNT_CURRENCY_CODE,
    A.IS_BACS_ACCOUNT,
    A.IS_EBAM_ACCOUNT,
    R.STATUS_CODE AS REQUEST_STATUS_CODE,
    R.SUB_STATUS_CODE AS REQUEST_SUB_STATUS_CODE,
    P.STATUS_CODE AS PARENT_REQUEST_STATUS_CODE
FROM AMT_ACCOUNT_REQUEST A
INNER JOIN AMT_REQUEST R
        ON R.REQUEST_ID = A.REQUEST_ID
LEFT JOIN AMT_PARENT_REQUEST P
       ON P.PARENT_REQUEST_ID = R.PARENT_REQUEST_ID
LEFT JOIN LEGAL_ENTITY L
       ON L.GFC_ID = A.GFC_ID
LEFT JOIN VW_AMT_REFS_BRANCHCODESLOOKUP RE
       ON RE.STR2 = A.BRANCH_CODE
      AND RE.STATUS = 1
WHERE R.REQUEST_ID IN ('2011042100020100482')
ORDER BY A.ACCOUNT_NUMBER;
