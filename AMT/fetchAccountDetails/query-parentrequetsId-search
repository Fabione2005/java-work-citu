SELECT
    R.PARENT_REQUEST_ID,
    COUNT(DISTINCT R.REQUEST_ID) AS REQUEST_COUNT,
    COUNT(DISTINCT A.ACCOUNT_REQUEST_ID) AS ACCOUNT_COUNT,
    MIN(R.CREATED_ON) AS MIN_REQUEST_CREATED_ON,
    MAX(R.CREATED_ON) AS MAX_REQUEST_CREATED_ON
FROM AMT_REQUEST R
INNER JOIN AMT_ACCOUNT_REQUEST A
        ON A.REQUEST_ID = R.REQUEST_ID
LEFT JOIN AMT_PARENT_REQUEST P
       ON P.PARENT_REQUEST_ID = R.PARENT_REQUEST_ID
WHERE R.PARENT_REQUEST_ID IS NOT NULL
GROUP BY R.PARENT_REQUEST_ID
ORDER BY MAX(R.CREATED_ON) DESC
FETCH FIRST 30 ROWS ONLY;
